{
	auto_https off
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode gzip

	handle /health {
		respond "ok" 200
	}

	@logto path /Callback /Callback/* /SignedOutCallback /SignedOutCallback/* /auth /auth/*
	handle @logto {
		reverse_proxy {$DOMUS_API_UPSTREAM} {
			header_up Host {host}
			# TLS ends at the Railway edge, so {scheme} is always http on this listener.
			header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
			header_up X-Forwarded-Host {host}
		}
	}

	handle_path /api/* {
		reverse_proxy {$DOMUS_API_UPSTREAM} {
			header_up Host {host}
			header_up X-Forwarded-Prefix /api
			# Same as the Logto routes: keep the edge scheme, not Caddy's own http.
			header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
			header_up X-Forwarded-Host {host}
		}
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
