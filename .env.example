# Logto IdP (preprod)
# Endpoint do tenant OIDC — já provisionado no Railway.
VITE_LOGTO_ENDPOINT=https://logto-auth-preprod.up.railway.app/

# App ID da application SPA criada no Logto Admin Console.
VITE_LOGTO_APP_ID=selfmzpi56ntd9xiedlpd

# Audience / API resource da API Domus no Logto (quando configurado).
# Necessário para o access token ser emitido para a API.
VITE_LOGTO_API_RESOURCE=

# API Domus (outro repositório) — placeholder até a API existir.
# Ex.: http://localhost:3001  ou  https://api.domus.example
VITE_DOMUS_API_BASE_URL=http://localhost:3000
