# Variáveis de ambiente do frontend (Vite).
# Copie para `.env.local` quando precisar configurar o app.
# Em Railway estas variáveis entram no bundle no `docker build` — não no runtime do Caddy.

# VITE_LOGTO_ENDPOINT=https://auth.domus.dev
# VITE_LOGTO_APP_ID=
# VITE_LOGTO_API_RESOURCE=
# VITE_LOGTO_PASSWORD_URL=
# VITE_DOMUS_API_BASE_URL=https://api.domus.dev
